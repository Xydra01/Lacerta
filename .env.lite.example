# Lacerta lite profile — Qwen3.5 4B, 8k context.
# Use on Windows, Linux, or macOS when the full 9B / 32k model does not fit.
# Do not set LACERTA_PROFILE=macos; lite is the cross-platform name.
# (macos is accepted as an alias of lite if an older Mac .env is copied.)
LACERTA_PROFILE=lite
LACERTA_WORKER_MAX_TURNS=5
LACERTA_MANAGER_MAX_STEPS=20
LACERTA_LLM_DECOMPOSE=0
LACERTA_LLM_DECOMPOSE_MAX=3
LACERTA_MAX_WRITE_CHARS=6000
LACERTA_TOOL_OUTPUT_CHAR_CAP=4000
LACERTA_HABIT_MODE=deterministic
LACERTA_WRITING_MODE=deterministic
LACERTA_LEARN_SYLLABUS_MODE=deterministic
OLLAMA_MODEL=lacerta:lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
